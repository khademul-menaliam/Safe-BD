# PostgreSQL / Neon connection string (pooled)
DATABASE_URL="postgresql://neondb_owner:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Direct URL for migrations (unpooled)
DIRECT_URL="postgresql://neondb_owner:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# NextAuth / Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Map provider (informational — OpenStreetMap tiles are used by default and need no key)
NEXT_PUBLIC_MAP_PROVIDER="openstreetmap"

# Future integration points:
LOCATION_PROVIDER="mock"
PAYMENT_PROVIDER="mock"
